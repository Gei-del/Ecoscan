# EcoScan — Configuración de seguridad Apache / Netlify / Vercel
# Copia este archivo como .htaccess en la raíz del servidor Apache
# Para Netlify/Vercel usa _headers o vercel.json (ver abajo)

# ========== SEGURIDAD HTTP HEADERS ==========

<IfModule mod_headers.c>
  # Previene ataques de clickjacking
  Header always set X-Frame-Options "DENY"

  # Previene sniffing de MIME type
  Header always set X-Content-Type-Options "nosniff"

  # Controla información de referencia
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Política de permisos (desactiva APIs no necesarias)
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy — solo recursos locales + Google Fonts
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"

  # Fuerza HTTPS (solo en producción con HTTPS)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Deshabilita caché de datos sensibles (por defecto)
  Header always set Cache-Control "no-store, no-cache, must-revalidate" env=!NO_CACHE

  # Caché larga para assets con hash
  <FilesMatch "\.(css|js|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    RequestHeader unset Cookie
  </FilesMatch>

  # Sin caché para HTML (siempre fresco)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ========== COMPRESIÓN ==========
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ========== TIPOS MIME ==========
<IfModule mod_mime.c>
  AddType application/manifest+json .json
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# ========== REDIRECCIÓN HTTPS (producción) ==========
